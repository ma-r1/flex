{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: Construir compilador",
      "command": "/usr/bin/gcc",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${workspaceFolder}/main.c",
        "${workspaceFolder}/alex.c",
        "${workspaceFolder}/asin.c",
        "${workspaceFolder}/se.c",
        "${workspaceFolder}/ts.c",
        "${workspaceFolder}/abb.c",
        "${workspaceFolder}/errores.c",
        "-I${workspaceFolder}/headerFiles",
        "-o",
        "${workspaceFolder}/main"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compila todos los módulos del proyecto y enlaza los headers."
    }
  ]
}